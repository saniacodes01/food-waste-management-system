# Copy to .env and adjust
DATABASE_URL=postgresql+asyncpg://foodwaste:password@localhost:5432/foodwaste_db
# Optional: keep all tables in one schema (use when you can't CREATE DATABASE
# on a shared Postgres). Leave blank to use the default schema.
DB_SCHEMA=
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
# origins allowed to call the API from a browser (the frontend's URL)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
# How far (km) to look for NGOs / delivery partners when matching a donation
MATCH_RADIUS_KM=25
